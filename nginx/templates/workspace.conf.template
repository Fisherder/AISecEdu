server_name $WORKSPACE_HOST;

resolver 127.0.0.11 valid=30s ipv6=off;
resolver_timeout 1s;

location ~ "^/w/(?P<container_id>[0-9a-f]{12})/auth/(?P<sig>[^/]+)/(?P<port>\d+)(?:/(?P<path>.*))?$" {
    secure_link_hmac "$sig";
    secure_link_hmac_secret "$WORKSPACE_SECRET";
    secure_link_hmac_message "$container_id";
    secure_link_hmac_algorithm sha256;

    if ($secure_link_hmac != "1") {
        error_page 404 = @workspace_not_found;
        return 404;
    }

    add_header Set-Cookie "aisecedu_workspace_cap=$sig; Path=/w/$container_id/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax" always;
    return 302 /w/$container_id/$port/$path$is_args$args;
}

location ~ "^/w/(?P<container_id>[0-9a-f]{12})/(?P<port>\d+)(?:/(?P<path>.*))?$" {
    secure_link_hmac "$cookie_aisecedu_workspace_cap";
    secure_link_hmac_secret "$WORKSPACE_SECRET";
    secure_link_hmac_message "$container_id";
    secure_link_hmac_algorithm sha256;

    if ($secure_link_hmac != "1") {
        error_page 404 = @workspace_not_found;
        return 404;
    }

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $workspace_cookie;
    proxy_set_header Authorization "";
    proxy_cookie_path ~^.*$ "/w/$container_id/$port/";

    proxy_intercept_errors on;
    error_page 502 = @workspace_not_found;

    proxy_pass http://$container_id:$port/$path$is_args$args;
}

location ~ ^/workspace/(?P<container_id>[^/:]+)/(?P<sig>[^/]+)/(?P<port>\d+)(?:/(?P<path>.*))?$ {
    secure_link_hmac "$sig";
    secure_link_hmac_secret "$WORKSPACE_SECRET";
    secure_link_hmac_message "$container_id";
    secure_link_hmac_algorithm sha256;

    if ($secure_link_hmac != "1") {
        error_page 404 = @workspace_not_found;
        return 404;
    }

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $workspace_cookie;
    proxy_set_header Authorization "";
    proxy_cookie_path ~^.*$ "/workspace/$container_id/$sig/$port/";

    set $workspace_accept_encoding $http_accept_encoding;
    if ($port = 7681) {
        set $workspace_accept_encoding "";
    }
    proxy_set_header Accept-Encoding $workspace_accept_encoding;
    gunzip on;
    sub_filter_once on;
    sub_filter '</head>' '<script id="aisecedu-terminal-keyboard-guard">(function(){if(location.pathname.indexOf("/7681/")===-1)return;var NativeWebSocket=window.WebSocket;var terminalSocket=null;window.WebSocket=new Proxy(NativeWebSocket,{construct:function(Target,args){var socket=new Target(...args);var protocols=args[1];if(protocols==="tty"||(Array.isArray(protocols)&&protocols.indexOf("tty")!==-1))terminalSocket=socket;return socket;}});function guardEscape(event){var target=event.target;if(event.key!=="Escape"||!target||!target.classList||!target.classList.contains("xterm-helper-textarea"))return;event.preventDefault();event.stopImmediatePropagation();if(event.type==="keydown"&&!event.repeat&&terminalSocket&&terminalSocket.readyState===NativeWebSocket.OPEN)terminalSocket.send(new Uint8Array([48,27]));setTimeout(function(){target.focus({preventScroll:true});},0);}window.addEventListener("keydown",guardEscape,true);window.addEventListener("keyup",guardEscape,true);})();</script></head>';

    proxy_intercept_errors on;
    error_page 502 = @workspace_not_found;

    proxy_pass http://$container_id:$port/$path$is_args$args;
}

location ~ ^/workspace/(?P<container_id>[^/]+):(?P<target_host>[^/]+)/(?P<sig>[^/]+)/(?P<port>\d+)(?:/(?P<path>.*))?$ {
    secure_link_hmac "$sig";
    secure_link_hmac_secret "$WORKSPACE_SECRET";
    secure_link_hmac_message "$container_id:$target_host";
    secure_link_hmac_algorithm sha256;

    if ($secure_link_hmac != "1") {
        error_page 404 = @workspace_not_found;
        return 404;
    }

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $workspace_cookie;
    proxy_set_header Authorization "";
    proxy_cookie_path ~^.*$ "/workspace/$container_id:$target_host/$sig/$port/";

    set $workspace_accept_encoding $http_accept_encoding;
    if ($port = 7681) {
        set $workspace_accept_encoding "";
    }
    proxy_set_header Accept-Encoding $workspace_accept_encoding;
    gunzip on;
    sub_filter_once on;
    sub_filter '</head>' '<script id="aisecedu-terminal-keyboard-guard">(function(){if(location.pathname.indexOf("/7681/")===-1)return;var NativeWebSocket=window.WebSocket;var terminalSocket=null;window.WebSocket=new Proxy(NativeWebSocket,{construct:function(Target,args){var socket=new Target(...args);var protocols=args[1];if(protocols==="tty"||(Array.isArray(protocols)&&protocols.indexOf("tty")!==-1))terminalSocket=socket;return socket;}});function guardEscape(event){var target=event.target;if(event.key!=="Escape"||!target||!target.classList||!target.classList.contains("xterm-helper-textarea"))return;event.preventDefault();event.stopImmediatePropagation();if(event.type==="keydown"&&!event.repeat&&terminalSocket&&terminalSocket.readyState===NativeWebSocket.OPEN)terminalSocket.send(new Uint8Array([48,27]));setTimeout(function(){target.focus({preventScroll:true});},0);}window.addEventListener("keydown",guardEscape,true);window.addEventListener("keyup",guardEscape,true);})();</script></head>';

    proxy_intercept_errors on;
    error_page 502 = @workspace_not_found;

    # route via the workspace nginx/gateway
    proxy_pass http://$target_host:8888/workspace/$container_id:$target_host/$sig/$port/$path$is_args$args;
}

location @workspace_not_found {
    internal;
    default_type text/plain;
    add_header Content-Type text/plain;
    return 404 "Workspace not found\n";
}
