rotor_c"],"question":"停机之后，哪一条读数开始跟随真实转速变化？"},{"at":78,"title":"复位与重复观察","caption":"重置后碎片重新隐藏，三台机壳与转子回到初始位置与不透明度并保持低速旋转，偏心示踪带仍可见，两套指针复位，流束停止，便于从任意阶段重新观察。","kind":"inspection","focus":["machine_a","machine_b","machine_c"],"question":"复位后三台机壳与转子是否都回到了可辨认的初始位置与状态？"}]},"options":{"requireComposition":true,"requiredObjects":["三台剖面离心机","每台离心机的独立可见转子","每台转子的偏心示踪带","HMI显示面板","物理转速独立观测标记","概念注入流束","级联解体碎片（至少4个有体积碎片）","来源机壳或转子","专门破坏近景","紧急停机控件"],"requiredInteractions":["观察三台剖面离心机的独立可见转子和偏心示踪带","调节概念转速","开始注入","HMI显示保持正常值而物理转速和独立观测持续变化","临界阶段触发真正的级联物理解体","至少4个有体积碎片从隐藏状态显现","碎片沿不同三维轨道飞散","来源机壳或转子同步真实变化","切换到专门破坏近景","紧急停机","暂停","单步","回拖时间轴","自由旋转、缩放场景","重置"],"interactionRequirements":[{"description":"观察三台剖面离心机的独立可见转子和偏心示踪带","kind":"view"},{"description":"调节概念转速","kind":"state-change"},{"description":"开始注入","kind":"state-change"},{"description":"HMI显示保持正常值而物理转速和独立观测持续变化","kind":"state-change"},{"description":"临界阶段触发真正的级联物理解体","kind":"structural-change"},{"description":"至少4个有体积碎片从隐藏状态显现","kind":"state-change"},{"description":"碎片沿不同三维轨道飞散","kind":"transport"},{"description":"来源机壳或转子同步真实变化","kind":"structural-change"},{"description":"切换到专门破坏近景","kind":"view"},{"description":"紧急停机","kind":"state-change"},{"description":"暂停","kind":"player-control","controls":["pause"]},{"description":"单步","kind":"player-control","controls":["step"]},{"description":"回拖时间轴","kind":"player-control","controls":["seek"]},{"description":"自由旋转、缩放场景","kind":"view"},{"description":"重置","kind":"player-control","controls":["reset"]}],"requiredPresentation":[]}}
