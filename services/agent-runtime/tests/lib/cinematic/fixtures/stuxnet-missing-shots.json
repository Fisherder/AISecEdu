{"scene":{"schemaVersion":"cinematic-v1","title":"离心机级联物理破坏——HMI欺骗与真实解体","subtitle":"三台剖面离心机：独立转子与偏心示踪带、HMI正常读数与物理真实状态的分离、级联解体碎片飞散","modelNote":"为看清内部，三台机壳前部采用剖面开口；偏心示踪带贴在转子朝向开口的一侧，碎片沿各自直线方向飞离。","duration":80,"objectives":["认识三台剖面离心机中每台独立可见转子及偏心示踪带的转动。","理解学习者调节概念转速并开始注入后，物理转速与独立观测持续变化。","理解HMI显示保持正常值而物理真实状态已经偏离，二者是两种独立读数。","理解临界阶段会发生真正的级联物理解体，碎片从隐藏状态显现。","观察至少四块有体积碎片沿不同三维轨道飞散，并对应来源机壳或转子的真实变化。","通过破坏近景与后续取证视角，比较HMI读数与物理证据的差异。","掌握暂停、单步、回拖、旋转缩放、紧急停机和重置的观察操作。","理解紧急停机后转子真实减速与链路断开的因果关系。"],"theme":{"background":"#070c17","accent":"#5bdded","secondary":"#f6a755","environment":"laboratory"},"nodes":[{"id":"machine_a","kind":"model","model":"centrifuge-housing","role":"primary","represents":"左侧剖面离心机机壳A","assetRole":"centrifuge-teaching-enclosure","label":"机壳A","detail":"剖面开口朝+Z，内部容纳独立转子与偏心示踪带；破坏章该机壳真实位移、缩放并淡出。","position":[-7.6,-0.008045711670716216,0],"rotation":[0,0,0],"scale":[1,1,1],"color":"#8b98a6","emissive":0,"metalness":0.62,"roughness":0.42,"opacity":1,"params":{"detail":2,"speed":1,"cutaway":true}},{"id":"rotor_a","kind":"cylinder","parent":"machine_a","role":"primary","represents":"机壳A内独立可见转子A","label":"转子A","detail":"位于机壳A内腔，绕Y轴转动，橙色的偏心示踪带贴在转子朝开口的侧面，随转子周期扫过。","position":[0,0.29466790765942025,0.026451376723326855],"rotation":[0,0,0],"scale":[1,1,1],"color":"#b8c6d4","emissive":0,"metalness":0.75,"roughness":0.28,"opacity":1,"params":{"top":0.34661834474095565,"bottom":0.34661834474095565,"height":2.384006270971677}},{"id":"trace_a","kind":"box","parent":"rotor_a","role":"primary","represents":"转子A的偏心示踪带","label":"偏心示踪带A","detail":"贴在转子+Z可见面的纵向条纹，随转子转动改变相位，用于观察旋转与偏心。","position":[0,0,0.38128017921505125],"rotation":[0,0,0],"scale":[1,1,1],"color":"#f6a755","emissive":0.7,"metalness":0.3,"roughness":0.4,"opacity":1,"params":{"width":0.1,"height":2.1456056438745095,"depth":0.12}},{"id":"machine_b","kind":"model","model":"centrifuge-housing","role":"primary","represents":"中间剖面离心机机壳B","assetRole":"centrifuge-teaching-enclosure","label":"机壳B","detail":"结构与机壳A一致，级联顺序