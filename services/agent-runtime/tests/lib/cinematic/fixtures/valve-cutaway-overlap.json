eat","bonnet-flange"],"question":"阀杆做的是什么运动，阀芯做的是什么运动，两者怎样对应？"},{"at":36,"title":"阀芯脱离阀座，流道开始贯通","caption":"阀芯升高后与阀座之间出现明显间隙，流道从阻断转为部分贯通；流向标记从入口侧出现并开始向出口移动。","kind":"action","focus":["valve-gate","valve-seat","flow-through","flow-arrow-1","flow-arrow-2","flow-inlet","flow-outlet"],"question":"流道开始贯通的可见证据是什么？"},{"at":58,"title":"完全打开：连续流动","caption":"阀芯升至最高位置，与阀座之间形成完整通道；阀杆和手轮停止旋转，流向标记连续从入口移动到出口，表示流体沿流道持续通过。","kind":"action","focus":["valve-gate","valve-seat","flow-through","flow-arrow-1","flow-arrow-2","flow-arrow-3","flow-inlet","flow-outlet"],"question":"哪些画面变化说明闸阀已经完全打开？"},{"at":72,"title":"总结与回看","caption":"回拖时间轴可看到阀芯下移、间隙缩小到重新阻断的反过程；重置后阀芯回到阀座，流向标记回到入口侧静止，恢复关闭初态。","kind":"summary","focus":["valve-gate","valve-seat","flow-through"],"question":"如果再次拖到中间时刻，阀芯位置和流向标记状态会怎样对应？"}]},"options":{"requireComposition":true,"requiredObjects":["阀体","阀芯","阀杆","流道","流向标记"],"requiredInteractions":["暂停播放以定格观察","单步播放逐段观察","拖动时间轴回拖查看","重置回到初始状态","自由旋转从任意角度观察","滚轮缩放拉近观察"],"interactionRequirements":[{"description":"暂停播放以定格观察","kind":"player-control","controls":["pause"]},{"description":"单步播放逐段观察","kind":"player-control","controls":["step"]},{"description":"拖动时间轴回拖查看","kind":"player-control","controls":["seek"]},{"description":"重置回到初始状态","kind":"player-control","controls":["reset"]},{"description":"自由旋转从任意角度观察","kind":"view"},{"description":"滚轮缩放拉近观察","kind":"view"}]}}
