log_format aisecedu_no_query '$remote_addr - [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';

map $http_upgrade $aisecedu_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8443 ssl http2;
    server_name 62.234.153.107;
    ssl_certificate /etc/nginx/tls/superhack.crt;
    ssl_certificate_key /etc/nginx/tls/superhack.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/aisecedu-access.log aisecedu_no_query;
    client_max_body_size 200m;
    location = /deployment-health {
        default_type text/plain;
        return 200 "AISecEdu deployment endpoint ready\n";
    }
    location / {
        proxy_pass https://127.0.0.1:9443;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /srv/aisecedu-dojo/data/local-tls/ca.crt;
        proxy_ssl_name 62.234.153.107;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $aisecedu_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

server {
    listen 4443 ssl http2;
    server_name 62.234.153.107;
    ssl_certificate /etc/nginx/tls/superhack.crt;
    ssl_certificate_key /etc/nginx/tls/superhack.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/aisecedu-access.log aisecedu_no_query;
    location = /deployment-health {
        default_type text/plain;
        return 200 "AISecEdu workspace endpoint ready\n";
    }
    location / {
        proxy_pass https://127.0.0.1:9444;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /srv/aisecedu-dojo/data/local-tls/ca.crt;
        proxy_ssl_name 62.234.153.107;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $aisecedu_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
