# Copy this file to ops/deployment.env and adapt it to the target host.
# The local file is intentionally ignored so one checkout can be deployed on
# multiple machines without committing host addresses or image selections.

# Leave DOJO_IMAGE unset to use the image tag written by `make build`.
# DOJO_IMAGE=pwncollege/dojo:local-01234567

DOJO_LISTEN_ADDRESS=127.0.0.1
DOJO_HTTP_PORT=80
DOJO_HTTPS_PORT=443
DOJO_SSH_PORT=2223
DOJO_HOST=localhost.pwn.college
WORKSPACE_HOST=workspace.localhost.pwn.college
WORKSPACE_HTTPS_PORT=4443
# Optional private upstream port when a host reverse proxy owns the public port.
# DOJO_WORKSPACE_PUBLISH_PORT=9444
DOJO_IP_MODE=false

# Adjust to the host capacity. The verified 300-workspace profile uses 230g.
DOJO_SHM_SIZE=16g

# Optional LAN certificate values for IP-mode deployments.
# DOJO_TLS_IPS=192.0.2.10
# DOJO_TLS_EXTRA_DNS=dojo.example.edu

# Optional proxy reachable from the outer container.
# DOJO_PROXY_URL=http://proxy.example.edu:3128
